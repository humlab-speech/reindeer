  author = person("Fredrik", "Nylén", email = "fredrik.nylen@umu.se",
                  comment = c(ORCID = "0000-0003-3373-0934")),
  year = year,
  note = vers,
  url = "https://github.com/humlab-speech/reindeer",
  textVersion = paste0("Nylén, Fredrik (", year, "). ",
                       "reindeer: Reproducible Analysis of Speech Corpora. ",
                       vers, ". https://github.com/humlab-speech/reindeer")
)
